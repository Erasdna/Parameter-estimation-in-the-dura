FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Newtonian fluid model
transportModel  Newtonian;

nu              nu [0 2 -1 0 0 0 0] 0.7; // Kinematic Viscosity (fitted in the solver) (mm2/s).


